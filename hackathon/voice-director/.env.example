# Server-side configuration for the voice-director slice.
# Copy to `.env` in this folder. Credentials never leave the server process.

# REQUIRED — the only provider credential. Server-side only; the browser bundle
# never sees it. A missing key is reported (health + 503), never invented.
OPENAI_API_KEY=

# Conversational voice model for the Responses API (input_audio -> output_audio).
# Pick one that supports audio output on your account. (Verify on build day.)
VOICE_DIRECTOR_MODEL=gpt-4o-audio-preview

# Provider voice for the returned direction audio.
VOICE_DIRECTOR_VOICE=alloy

# Local API server port.
VOICE_DIRECTOR_PORT=8787

# Vite dev origin allowed through CORS.
VOICE_DIRECTOR_ALLOWED_ORIGIN=http://localhost:5173

# Provider base URL (override for proxies/gateways).
# VOICE_DIRECTOR_BASE_URL=https://api.openai.com/v1

# --- Realtime relay (full-duplex WebSocket; server-owned session) ---
# Same OPENAI_API_KEY as the one-shot voice path, used server-side only.
# Realtime model: gpt-realtime family (default below; verify availability).
VOICE_DIRECTOR_REALTIME_MODEL=gpt-realtime-2.1
# Voice for provider audio output in the realtime session.
VOICE_DIRECTOR_REALTIME_VOICE=alloy
# Operator-speech transcription for the transcript event (on/off).
# VOICE_DIRECTOR_REALTIME_TRANSCRIPTION=true
# Realtime WebSocket URL override; defaults to baseUrl https->wss + /realtime.
# VOICE_DIRECTOR_REALTIME_WS_URL=wss://api.openai.com/v1/realtime
# Transcription model when transcription is enabled.
# VOICE_DIRECTOR_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Deepgram Agent realtime provider (parallel option, server-side only) ---
# Same local protocol + runbook as the OpenAI relay. Selected with:
#   VOICE_DIRECTOR_REALTIME_PROVIDER=deepgram
# The key rides the Agent WebSocket upgrade header; it never reaches a browser
# frame or /api/health. A missing key is reported (health + local error + 1013),
# never invented.
VOICE_DIRECTOR_REALTIME_PROVIDER=openai
# DEEPGRAM_API_KEY=

# Captured hackathon session config (Agent API). Listen models must be the
# flux-* family with the Agent `version: v2` (the relay enforces it).
# VOICE_DIRECTOR_DEEPGRAM_LISTEN_MODEL=flux-general-en
# VOICE_DIRECTOR_DEEPGRAM_SPEAK_MODEL=flux-kit-en
# VOICE_DIRECTOR_DEEPGRAM_LLM_PROVIDER=google
# VOICE_DIRECTOR_DEEPGRAM_LLM_MODEL=gemini-3.1-flash-lite
# VOICE_DIRECTOR_DEEPGRAM_WS_URL=wss://agent.deepgram.com/v1/agent/converse

# Default job when no session has been started.
# VOICE_DIRECTOR_JOB=Assemble the desk-side drill station.

# OPTIONAL — Slack Socket Mode bot. Requires both tokens; the bot joins any
# channel it is added to and replies to @mention with a concise direction.
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...