{
  "name": "@skillio/hackathon-voice-director",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx --env-file-if-exists=.env watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.71.1",
    "@copilotkit/react-ui": "1.71.1",
    "@copilotkit/runtime": "1.71.1",
    "@skillio/mcp-protocol": "workspace:*",
    "@skillio/voice-coach": "workspace:*",
    "@slack/bolt": "^5.1.0",
    "express": "^5.2.1",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vite": "^5"
  }
}